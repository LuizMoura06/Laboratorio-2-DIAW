# Use a string de conexão JDBC do Supabase em modo Session Pooler (porta 5432).
# A conexão deve utilizar TLS, com sslmode=require.
SPRING_DATASOURCE_URL=jdbc:postgresql://SEU_HOST.pooler.supabase.com:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres.SEU_PROJECT_REF
SPRING_DATASOURCE_PASSWORD=SUA_SENHA_AQUI
FRONTEND_ORIGIN=http://localhost:5173

